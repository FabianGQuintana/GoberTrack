# Configuración del modo testnet (npm run dev:testnet / start:testnet / fixtures:testnet).
# Las variables que ya estén definidas en el entorno tienen prioridad sobre este archivo.
# Si el contrato se redespliega, se cambian CONTRATO_ID y START_LEDGER (ver contracts/DEPLOY.md);
# al arrancar con otro contrato, el indexador descarta lo indexado y empieza de cero.
MODO_DATOS=testnet
CONTRATO_ID=CCRFFXP25OT5FOI3VJXAX666QI76YWHV52IYTG45ICK4TMB7QFS7KYSM
START_LEDGER=5220081
RPC_URL=https://soroban-testnet.stellar.org
# NETWORK_PASSPHRASE: por defecto Networks.TESTNET del SDK ("Test SDF Network ; September 2015").
POLL_MS=5000
