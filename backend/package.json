{
  "name": "opv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Obra Pública Verificable: API de lectura + evidencia (interfaces/openapi.yaml v1.0.0)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "dev:testnet": "node --env-file=testnet.env --watch --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "start:testnet": "node --env-file=testnet.env --disable-warning=ExperimentalWarning dist/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed/cli.ts",
    "fixtures:testnet": "node --env-file=testnet.env --disable-warning=ExperimentalWarning scripts/capturar-fixtures-testnet.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@stellar/stellar-sdk": "^17.2.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
